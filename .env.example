# ==============================================================================
# AQUAGREEN SMART IRRIGATION SYSTEM - ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# 1. AI Studio Applet Settings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# 2. Production Database: Supabase PostgreSQL Connection URL
# Obtain from Supabase Project Settings -> Database -> Connection String (URI / Pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-strong-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 3. Security Tokens (Optional for public deployment protection)
# AQUAGREEN_DEVICE_TOKEN: Shared secret token for physical ESP32 HTTP requests
AQUAGREEN_DEVICE_TOKEN="aquagreen_device_secret_2026"

# DASHBOARD_API_KEY: Secret key required for remote pump override commands
DASHBOARD_API_KEY="aquagreen_admin_key_2026"

# 4. Frontend Client API Base URL
# Leave empty ("") when frontend and API are hosted together on Vercel
VITE_API_BASE_URL=""
